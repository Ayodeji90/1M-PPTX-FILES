# Copy to .env and fill in. Never commit the real .env file.

# Contact email embedded in the User-Agent string sent to every server
# we touch (robots.txt, HEAD, GET, EDGAR). Required -- the pipeline
# refuses to start without it.
CONTACT_EMAIL=you@example.com

# Optional: override the rclone remote name configured on this box
# (must already exist in `rclone config`, e.g. `rclone config show gdrive`).
RCLONE_REMOTE=gdrive

# Multi-machine operation. Every machine (your laptop + each GCP VM)
# points at the SAME Drive folder and runs the SAME code; these two
# numbers split the work so no two machines ever touch the same website.
# Machine 1 of 3 -> NODE_ID=0 NODE_COUNT=3; machine 2 -> NODE_ID=1; etc.
# Single-machine operation: leave as 0 and 1.
NODE_ID=0
NODE_COUNT=1

# Optional: GitHub token for the Tier 6 Code Search harvester (raises
# rate limit from 10/min unauthenticated to 30/min for code search).
GITHUB_TOKEN=

# Optional: SEC EDGAR full-text search does not require a key but does
# require a descriptive User-Agent (already built from CONTACT_EMAIL).
