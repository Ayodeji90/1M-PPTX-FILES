# PptxSweeper systemd service for a 24/7 headless VM (Azure free-tier /
# credit VM, or any always-on box). Keeps the pipeline running across
# reboots and crashes with no SSH session needed.
#
# Install:
#   sudo cp deploy/pptxsweeper.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pptxsweeper
#
# Watch it:
#   systemctl status pptxsweeper
#   journalctl -u pptxsweeper -f          # live logs
#   journalctl -u pptxsweeper -n 200      # recent logs
#
# Notes:
#   - Paths below are for the primary Azure VM. If you deploy to another
#     machine, change User=/WorkingDirectory=/EnvironmentFile=/ExecStart=
#     to that box's repo path FIRST -- the template is not portable
#     verbatim (a wrong path makes the unit fail with "Failed to load
#     environment files").
#   - PPTXSWEEPER_OVERRIDE points at the VM tuning profile (config.vm.yaml).
#   - .env must exist in WorkingDirectory (CONTACT_EMAIL, NODE_ID, ...).
#   - First-time rclone auth still needs one manual step (see DEPLOY.md:
#     `rclone config` with a laptop-generated token) -- run it once before
#     enabling the service, or the service will crash-loop until fixed.

[Unit]
Description=PptxSweeper million-scale .ppt/.pptx acquisition pipeline
Documentation=https://github.com/Ayodeji90/1M-PPTX-FILES
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/1M-PPTX-FILES
Environment=PPTXSWEEPER_OVERRIDE=config.vm.yaml
EnvironmentFile=/home/azureuser/1M-PPTX-FILES/.env
ExecStart=/home/azureuser/1M-PPTX-FILES/.venv/bin/pptxsweeper run
Restart=always
RestartSec=30
# SIGTERM lets the pipeline finish in-flight work gracefully (download
# grace window + subprocess shutdown), so no row is ever lost.
KillSignal=SIGTERM
TimeoutStopSec=120
# One pipeline per machine by design (sqlite single-writer).
# Many concurrent sockets for the async downloader.
LimitNOFILE=65536
# WAL sqlite + a few subprocesses; raise the soft limit slightly.
LimitNPROC=1024
# ----------------------------------------------------------------------
# MEMORY ARMOR (prevents OS-level wedge): the pipeline shares the box
# with sshd/journald/systemd. If classify + LibreOffice conversions ever
# exhaust RAM *and* swap, the kernel enters a swap-thrash death spiral --
# 100% CPU swapping, every process (incl. sshd) freezes, and the OOM
# killer never fires because memory is "reclaimable" (it's all in swap).
# The box becomes a zombie that only a cold reboot fixes.
#
# These cgroup limits convert that into a CLEAN SERVICE RESTART:
#   MemoryHigh=5G     soft cap -- kernel applies reclaim pressure early
#   MemoryMax=6G      hard cap  -- cgroup OOM below this kills ONLY the
#                     pipeline's processes, never the OS (which keeps
#                     ~1.8G RAM + swap for itself: sshd stays alive)
#   MemorySwapMax=1G  the pipeline may only thrash 1G of swap, so it
#                     can never drag the whole box into the spiral
#   OOMPolicy=kill    on cgroup OOM, systemd kills the service and
#                     Restart=always brings it back in ~30s
# Rows are crash-safe (WAL sqlite + resumable stages): a memory-spike
# restart loses nothing but the stuck time.
MemoryHigh=5G
MemoryMax=6G
MemorySwapMax=1G
OOMPolicy=kill

[Install]
WantedBy=multi-user.target
